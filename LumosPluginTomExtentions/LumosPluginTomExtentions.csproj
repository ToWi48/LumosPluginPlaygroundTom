<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<OutputType>Library</OutputType>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AssemblyTitle>LumosPluginTomExtentions</AssemblyTitle>
		<Product>LumosPluginTomExtentions</Product>
		<Copyright>Copyright © 2025</Copyright>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>

		<AssemblySearchPaths>
			$(AssemblySearchPaths);
			C:\Program Files (x86)\DMXControl3\Kernel;
			C:\Program Files (x86)\DMXControl3\GUI
		</AssemblySearchPaths>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="System.Drawing.Common" Version="8.0.0" />
		<PackageReference Include="Google.Protobuf" Version="3.28.2" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="Lumos">
			<HintPath>E:\DMXControl 3\Kernel\Lumos.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="LumosLIB">
			<HintPath>E:\DMXControl 3\Kernel\LumosLIB.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="LumosProtobuf">
			<HintPath>E:\DMXControl 3\Kernel\LumosProtobuf.dll</HintPath>
		</Reference>
		<Reference Include="LumosToolsLIB">
			<HintPath>E:\DMXControl 3\Kernel\LumosToolsLIB.dll</HintPath>
		</Reference>
	</ItemGroup>
</Project>